"<br /><br />\n"
"            Sci Club Tarcento\n"
"        </html>\n"
"        "
msgstr "\n        <html>\n            Caro/a %(first_name)s %(last_name)s,<br />\n            Il tuo certificato medico e' scaduto il %(expiry_date)s, quindi non puoi\n            partecipare alle attivita' che lo richiedono finche' non ci invii\n            uno nuovo.<br />\n            Puoi consegnarlo in segreteria o rispondere a questa email.<br /><br />\n            Sci Club Tarcento\n        </html>\n        "

